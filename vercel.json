{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pet-hospital-near-me",
      "destination": "/#book",
      "statusCode": 301
    },
    {
      "source": "/index",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/post/exotic-pet-care-in-pune-trusted-veterinary-support-at-shivraj-pet-clinic",
      "destination": "/blog/exotic-pet-care-pune",
      "statusCode": 301
    },
    {
      "source": "/post/:slug*",
      "destination": "/blog/",
      "statusCode": 301
    },
    {
      "source": "/service-page/consultation",
      "destination": "/services/clinical-medicine",
      "statusCode": 301
    },
    {
      "source": "/service-page/in-house-sonography",
      "destination": "/services/sonography",
      "statusCode": 301
    },
    {
      "source": "/service-page/pharmacy-mini-pet-shop",
      "destination": "/services/vet-pharmacy",
      "statusCode": 301
    },
    {
      "source": "/service-page/whiskers-pet-shop",
      "destination": "/services/vet-pharmacy",
      "statusCode": 301
    },
    {
      "source": "/service-page/:slug*",
      "destination": "/services/",
      "statusCode": 301
    },
    {
      "source": "/about-3",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/book-online",
      "destination": "/contact#book",
      "statusCode": 301
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/blog/neutering-rabbits-pune",
      "destination": "/blog/neutering-rabbits",
      "statusCode": 301
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/images/p/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/images/ui/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
